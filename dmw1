## C Program: WEKA Dataset Analysis

```c
#include <stdio.h>

int main() {
    printf("WEKA Data Mining Toolkit\n\n");

    printf("Dataset: weather.nominal\n");
    printf("Number of Instances: 14\n");
    printf("Number of Attributes: 5\n");
    printf("Class Attribute: play\n\n");

    printf("Class Distribution:\n");
    printf("yes = 9\n");
    printf("no  = 5\n\n");

    printf("Dataset: iris\n");
    printf("Number of Instances: 150\n");
    printf("Number of Attributes: 5\n");
    printf("Class Attribute: class\n\n");

    printf("Class Distribution:\n");
    printf("Iris-setosa     = 50\n");
    printf("Iris-versicolor = 50\n");
    printf("Iris-virginica  = 50\n");

    return 0;
}
```

